# Private quiz exports and participant-derived analysis
# Keep real data in these folders; synthetic fixtures remain trackable.
private_responses/
private-responses/
participant_responses/
participant-responses/
private_output/
private-output/
participant_output/
participant-output/
analysis/local_input/
analysis/local_output/
traveler-*-r*.json

# Allow deliberately named synthetic export fixtures in these locations.
!analysis/sample_responses/traveler-*-r*.json
!tests/fixtures/traveler-*-r*.json

